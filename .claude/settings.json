{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Task",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/ensure-test-deps-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-issue-labels.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-issue-labels.py"
          }
        ]
      }
    ]
  }
}
