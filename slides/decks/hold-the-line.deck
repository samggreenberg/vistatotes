# (thresh)Hold The Line — advances in VTSearch calibration.
# Mildly technical audience with no prior exposure to VTSearch: the opening
# third builds the tool, and lands on the one object the whole talk is about —
# a line through a ranking that decides twice, what comes back and what you are
# asked next. That first third is deliberately click-by-click — make a
# detector, answer questions, run it over media nobody voted on — because a
# room that has not seen the tool cannot be told about a threshold inside it.
#
# Then the ideas, in order: four iterations on where the line goes, then the
# same machinery walked a second time along the Inclusion axis — where
# the *user* wants it — and then the epilogue that closed the cut-rule question
# for good.
#
# The deck is ideas, not experiments: it presents findings, and the studies
# behind them live in the reports the presenter notes cite (see #3246, #3265).
#
# The outline fragment appears six times: once bare, as the opening list, and
# then once before each section marked with `+at1` … `+at5`. It is one slide
# shown six ways rather than six slides — `build.py` numbers it 1a…1f — and the
# last showing, with "The End" marked, is the deck's closing slide.

theme: vtsearch

slides:
  title-hold-the-line
  outline-hold-the-line

  # 1 — VTSearch
  outline-hold-the-line +at1
  problem
  make-detector
  train-loop
  find-results
  vote-boundary

  # 2 — Calibration
  outline-hold-the-line +at2
  xcal
  gmm-idea
  gmm-em
  blend
  blend-schedule
  anchored-gmm
  anchored-em
  quantile-transfer
  split-fraction

  # 3 — Preference
  outline-hold-the-line +at3
  inclusion-rank
  inclusion-cost
  inclusion-knob
  inclusion-walk
  inclusion-tilt
  inclusion-acq

  # 4 — Regions
  outline-hold-the-line +at4
  voting-modes
  evt-midpoint
  evt-gumbel
  evt-close

  # 5 — The End
  outline-hold-the-line +at5

  # Appendix — after the end, for questions. The Train/Check result is a
  # results slide, not an idea: the argument carries the change, this carries
  # the sweep that justified it, and it comes up only if someone asks.
  split-fraction-result

  # Appendix — what "logo detection" actually means. Parked after the end for
  # now, to be worked into the argument later: it is the `book` slide's claim
  # made a second time, in the one domain where a room expects a concept to
  # have a published spec sheet. Eight results for one query, arriving one at a
  # time, and the presenter asks about each without answering.
  logo-grid
